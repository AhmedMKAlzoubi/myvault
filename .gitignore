# --- Never commit secrets or the vault itself ---
# (The vault lives in your user profile, not here, but just in case.)
# Note: patterns are kept specific so docs like VAULT_FORMAT.md are NOT ignored.
*.dat
*.vault
vault.dat
vault.dat.tmp
*.tmp

# ...but DO keep the cross-language test vector (a throwaway vault whose
# password is published in test_fixtures/README — safe to commit).
!android_app/test_fixtures/fixture_vault.dat

# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
build/
dist/
*.egg-info/

# OS / editor junk
.DS_Store
Thumbs.db
.idea/
.vscode/
