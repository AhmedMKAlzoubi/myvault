{
  "_about": "Document types and the fields each one shows. Shared by the Windows app and the phone app: android_app/assets/doc_types.json must stay identical (tests/test_core.py checks it).",
  "fields": {
    "holder": {"label": "Name on the document"},
    "number": {"label": "Document number", "secret": true},
    "nationality": {"label": "Nationality"},
    "birth_date": {"label": "Date of birth", "date": true},
    "birth_place": {"label": "Place of birth"},
    "gender": {"label": "Sex"},
    "address": {"label": "Address", "multi": true},
    "phone": {"label": "Phone", "type": "tel"},
    "email": {"label": "Email", "type": "email"},
    "licence_class": {"label": "Licence class"},
    "visa_type": {"label": "Visa type"},
    "employer": {"label": "Sponsor or employer"},
    "plate": {"label": "Plate number"},
    "vehicle": {"label": "Make and model"},
    "vin": {"label": "Chassis number (VIN)", "mono": true},
    "landlord": {"label": "Landlord"},
    "rent": {"label": "Rent"},
    "insurer": {"label": "Insurer"},
    "country": {"label": "Issued by", "ph": "e.g. Jordan"},
    "issued": {"label": "Issue date", "date": true},
    "expires": {"label": "Expiry date", "date": true}
  },
  "types": {
    "passport": {"label": "Passport",
      "fields": ["holder", "number", "nationality", "birth_date", "birth_place", "gender", "country", "issued", "expires"]},
    "id_card": {"label": "ID card",
      "fields": ["holder", "number", "nationality", "birth_date", "birth_place", "gender", "address", "country", "issued", "expires"]},
    "residence": {"label": "Residence permit",
      "fields": ["holder", "number", "nationality", "birth_date", "employer", "address", "country", "issued", "expires"]},
    "visa": {"label": "Visa",
      "fields": ["holder", "number", "visa_type", "nationality", "birth_date", "country", "issued", "expires"]},
    "driving_license": {"label": "Driving licence",
      "fields": ["holder", "number", "licence_class", "birth_date", "address", "country", "issued", "expires"]},
    "car_registration": {"label": "Car registration",
      "fields": ["holder", "plate", "vehicle", "vin", "number", "address", "country", "issued", "expires"],
      "labels": {"holder": "Owner", "number": "Registration number"}},
    "rental": {"label": "Rental contract",
      "fields": ["holder", "landlord", "address", "rent", "phone", "number", "issued", "expires"],
      "labels": {"holder": "Tenant", "number": "Contract number", "issued": "Start date", "expires": "End date"}},
    "insurance": {"label": "Insurance",
      "fields": ["holder", "insurer", "number", "phone", "issued", "expires"],
      "labels": {"holder": "Insured", "number": "Policy number", "issued": "Start date", "expires": "End date"}},
    "other": {"label": "Document",
      "fields": ["holder", "number", "country", "issued", "expires"]}
  }
}
